# Normalise to LF in the repository.
* text=auto eol=lf

# These are executed by bash inside WSL / on the Pi. A CRLF checkout makes bash fail
# with "bad interpreter: /bin/bash^M" or silently mangle here-docs, so pin them to LF
# regardless of the checkout platform's core.autocrlf setting.
*.sh            text eol=lf
Caddyfile       text eol=lf
*.conf          text eol=lf

# Windows-only helpers keep CRLF.
*.bat           text eol=crlf
*.ps1           text eol=crlf

*.png binary
*.exe binary
